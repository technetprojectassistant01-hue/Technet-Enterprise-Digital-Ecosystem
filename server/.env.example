PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://user:password@localhost:5432/technet_digital?schema=public"
JWT_SECRET="replace-with-a-long-random-string"

# Password reset emails (https://resend.com). Leave RESEND_API_KEY unset in
# local dev to have reset links logged to the console instead of emailed.
RESEND_API_KEY=""
EMAIL_FROM="Technet Digital <onboarding@resend.dev>"

# Seed script (creates the first admin user)
SEED_ADMIN_EMAIL="admin@technet.com"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_ADMIN_NAME="Technet Admin"

# Web Push for the 08:15 check-in reminder. Generate the VAPID pair once with
# `npx web-push generate-vapid-keys` - regenerating later invalidates every
# subscription technicians have already created. Leave unset in local dev to
# have every send become a no-op instead of failing.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@technet.com"

# Guards POST /api/push/send-checkin-reminders, which the scheduled workflow in
# .github/workflows/checkin-reminder.yml calls each morning. Must be a real
# random string in production and match the GitHub repository secret of the same
# name exactly - the endpoint answers 404 on a mismatch, which is indistinguishable
# from the route not existing.
REMINDER_TRIGGER_SECRET="replace-with-a-long-random-string"
