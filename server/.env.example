PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://user:password@localhost:5432/technet_digital?schema=public"
JWT_SECRET="replace-with-a-long-random-string"

# Password reset emails (https://resend.com). Leave RESEND_API_KEY unset in
# local dev to have reset links logged to the console instead of emailed.
RESEND_API_KEY=""
EMAIL_FROM="Technet Digital <onboarding@resend.dev>"

# Seed script (creates the first admin user)
SEED_ADMIN_EMAIL="admin@technet.com"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_ADMIN_NAME="Technet Admin"
