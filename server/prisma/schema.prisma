// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES_OFFICER
  FINANCE_OFFICER
  STOREKEEPER
  HR_OFFICER
  OPERATIONS_MANAGER
  FIELD_TECHNICIAN
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  CASUAL
  INTERN
  CONSULTANT
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  PUBLIC_HOLIDAY
  REST_DAY
}

enum ProjectStatus {
  QUOTED
  APPROVED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CLOSED
  CANCELLED
}

enum ServiceCategory {
  ELECTRICAL
  ELV_SECURITY
  MECHANICAL
  PLUMBING
  SAFETY
  OTHER
}

enum ContractStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  CANCELLED
}

enum RequisitionStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum DocumentCategory {
  CONTRACT
  INVOICE
  HR
  PROJECT
  GENERAL
}

enum JobCategory {
  INSTALLATION
  START_UP_COMMISSIONING
  OUTDOOR_REPAIR
  WORKSHOP_REPAIR
  SERVICING
  MAINTENANCE_CONTRACT
  SURVEY
  OTHERS
}

enum WorkOrderStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WarrantyStatus {
  YES
  NO
  UNKNOWN
}

enum ReportStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum ReminderInterval {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
}

enum PhotoKind {
  EQUIPMENT
  WORK_DONE
}

enum AssetStatus {
  ACTIVE
  DECOMMISSIONED
}

enum MaintenanceFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum MaintenanceContractStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MaintenanceRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceRequestStatus {
  SUBMITTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MaintenanceScheduleStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(EMPLOYEE)
  createdAt    DateTime @default(now())

  employee                 Employee?
  stockMovements           StockMovement[]
  uploadedDocuments        Document[]
  projectStatusChanges     ProjectStatusHistory[]
  requisitionsRequested    PurchaseRequisition[]      @relation("RequisitionRequester")
  requisitionStatusChanges RequisitionStatusHistory[] @relation("RequisitionStatusChanger")
  goodsReceipts            GoodsReceipt[]

  workOrdersCreated           WorkOrder[]          @relation("WorkOrderCreator")
  dailyWorkReportsSubmitted   DailyWorkReport[]    @relation("DailyReportSubmitter")
  dailyWorkReportsReviewed    DailyWorkReport[]    @relation("DailyReportReviewer")
  interventionReportsCreated  InterventionReport[] @relation("InterventionReportCreator")
  interventionReportsReviewed InterventionReport[] @relation("InterventionReportReviewer")

  leaveRequestsCreated  LeaveRequest[] @relation("LeaveCreator")
  leaveRequestsReviewed LeaveRequest[] @relation("LeaveReviewer")

  attendanceRecorded AttendanceRecord[] @relation("AttendanceRecorder")

  passwordResetTokens PasswordResetToken[]

  maintenanceContractsCreated MaintenanceContract[] @relation("MaintenanceContractCreator")
  maintenanceRequestsMade     MaintenanceRequest[]  @relation("MaintenanceRequestRequester")
  maintenanceSchedulesCreated MaintenanceSchedule[] @relation("MaintenanceScheduleCreator")
  maintenanceReportsSubmitted MaintenanceReport[]   @relation("MaintenanceReportSubmitter")
  maintenanceReportsReviewed  MaintenanceReport[]   @relation("MaintenanceReportReviewer")

  payrollRunsCreated PayrollRun[] @relation("PayrollRunCreator")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Employee {
  id               String           @id @default(uuid())
  employeeCode     String           @unique
  firstName        String
  lastName         String
  email            String?
  phone            String?
  position         String?
  department       String?
  employmentStatus EmploymentStatus @default(ACTIVE)
  hireDate         DateTime?
  userId           String?          @unique
  user             User?            @relation(fields: [userId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Personal details
  nationalId  String?   @unique
  dateOfBirth DateTime?
  gender      Gender?
  address     String?

  // Emergency contact
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Employment terms
  contractType     ContractType?
  jobGrade         String?
  probationEndDate DateTime?
  contractEndDate  DateTime?
  exitDate         DateTime?
  exitReason       String?

  // Payroll details
  basicSalary       Decimal? @db.Decimal(12, 2)
  bankName          String?
  bankAccountNumber String?

  notes String?

  managedProjects    Project[]           @relation("ProjectManager")
  projectAssignments ProjectAssignment[]

  workOrderAssignments          WorkOrderTechnician[]
  dailyWorkReportAssignments    DailyWorkReportTechnician[]
  interventionReportAssignments InterventionReportTechnician[]

  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  attendanceRecords AttendanceRecord[]
  certifications    Certification[]
  trainingRecords   TrainingRecord[]

  maintenanceScheduleAssignments MaintenanceScheduleTechnician[]

  payrollLines PayrollLine[]
}

model Certification {
  id                String    @id @default(uuid())
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name              String
  category          String?
  issuingBody       String?
  certificateNumber String?
  issueDate         DateTime?
  expiryDate        DateTime?
  notes             String?

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([expiryDate])
}

model TrainingRecord {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title         String
  provider      String?
  completedDate DateTime?
  durationHours Decimal?  @db.Decimal(6, 2)
  cost          Decimal?  @db.Decimal(12, 2)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  status     AttendanceStatus @default(PRESENT)

  // Clock times are stored as "HH:MM" local wall-clock strings. The business
  // runs in a single timezone, so this avoids UTC conversion errors entirely.
  clockIn      String?
  clockOut     String?
  breakMinutes Int     @default(0)

  hoursWorked   Decimal? @db.Decimal(5, 2)
  overtimeHours Decimal  @default(0) @db.Decimal(5, 2)
  note          String?

  recordedById String?
  recordedBy   User?   @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

model LeaveType {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String   @unique
  daysPerYear  Decimal  @default(0) @db.Decimal(5, 2)
  paid         Boolean  @default(true)
  requiresDocs Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  balances LeaveBalance[]
  requests LeaveRequest[]
}

model LeaveBalance {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     String
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year            Int
  entitledDays    Decimal   @default(0) @db.Decimal(5, 2)
  carriedOverDays Decimal   @default(0) @db.Decimal(5, 2)
  usedDays        Decimal   @default(0) @db.Decimal(5, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([year])
}

model LeaveRequest {
  id          String             @id @default(uuid())
  employeeId  String
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType          @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  days        Decimal            @db.Decimal(5, 2)
  halfDay     Boolean            @default(false)
  reason      String?
  status      LeaveRequestStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  createdById String?
  createdBy   User?   @relation("LeaveCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, startDate])
  @@index([status])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  company   String?
  address   String?
  vatNumber String?
  taxNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts           Contract[]
  quotations          Quotation[]
  invoices            Invoice[]
  projects            Project[]
  documents           Document[]
  workOrders          WorkOrder[]
  interventionReports InterventionReport[]
  assets              Asset[]
}

model Contract {
  id         String         @id @default(uuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  service    String
  value      Decimal        @db.Decimal(14, 2)
  status     ContractStatus @default(PLANNING)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  projects Project[]
}

model Quotation {
  id              String          @id @default(uuid())
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  quotationNumber String          @unique
  title           String
  status          QuotationStatus @default(DRAFT)
  vatRate         Decimal         @default(15) @db.Decimal(5, 2)
  subtotal        Decimal         @db.Decimal(14, 2)
  vatAmount       Decimal         @db.Decimal(14, 2)
  total           Decimal         @db.Decimal(14, 2)
  issuedAt        DateTime        @default(now())
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items QuotationItem[]
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(14, 2)
}

model Invoice {
  id            String        @id @default(uuid())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id])
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  vatRate       Decimal       @default(15) @db.Decimal(5, 2)
  subtotal      Decimal       @db.Decimal(14, 2)
  vatAmount     Decimal       @db.Decimal(14, 2)
  total         Decimal       @db.Decimal(14, 2)
  poReference   String?
  terms         String?
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)
}

model Expense {
  id          String    @id @default(uuid())
  category    String
  description String?
  amount      Decimal   @db.Decimal(14, 2)
  date        DateTime  @default(now())
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  createdAt   DateTime  @default(now())
}

model Supplier {
  id           String   @id @default(uuid())
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  paymentTerms String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  expenses       Expense[]
  inventoryItems InventoryItem[]
}

model PurchaseOrder {
  id            String               @id @default(uuid())
  poNumber      String               @unique
  supplierId    String
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  requisitionId String?
  requisition   PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  status        PurchaseOrderStatus  @default(DRAFT)
  orderDate     DateTime             @default(now())
  expectedDate  DateTime?
  totalAmount   Decimal              @db.Decimal(14, 2)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
}

model PurchaseOrderItem {
  id              String         @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  description     String
  quantity        Int
  unitCost        Decimal        @db.Decimal(14, 2)

  goodsReceiptItems GoodsReceiptItem[]
}

model PurchaseRequisition {
  id                String            @id @default(uuid())
  requisitionNumber String            @unique
  projectId         String?
  project           Project?          @relation(fields: [projectId], references: [id])
  requestedById     String
  requestedBy       User              @relation("RequisitionRequester", fields: [requestedById], references: [id])
  status            RequisitionStatus @default(SUBMITTED)
  neededByDate      DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items          PurchaseRequisitionItem[]
  statusHistory  RequisitionStatusHistory[]
  purchaseOrders PurchaseOrder[]
}

model PurchaseRequisitionItem {
  id              String              @id @default(uuid())
  requisitionId   String
  requisition     PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem?      @relation(fields: [inventoryItemId], references: [id])
  description     String
  quantity        Int
}

model RequisitionStatusHistory {
  id            String              @id @default(uuid())
  requisitionId String
  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  fromStatus    RequisitionStatus?
  toStatus      RequisitionStatus
  changedById   String
  changedBy     User                @relation("RequisitionStatusChanger", fields: [changedById], references: [id])
  note          String?
  createdAt     DateTime            @default(now())
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedById    String
  receivedBy      User          @relation(fields: [receivedById], references: [id])
  notes           String?
  createdAt       DateTime      @default(now())

  items GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  quantityReceived    Int
}

model InventoryItem {
  id            String    @id @default(uuid())
  sku           String    @unique
  name          String
  category      String?
  unitOfMeasure String    @default("unit")
  quantity      Int       @default(0)
  minStockLevel Int       @default(0)
  unitCost      Decimal?  @db.Decimal(14, 2)
  location      String?
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  movements          StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  requisitionItems   PurchaseRequisitionItem[]
}

model StockMovement {
  id              String            @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type            StockMovementType
  quantity        Int
  reason          String?
  createdById     String
  createdBy       User              @relation(fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())
}

model Project {
  id              String          @id @default(uuid())
  name            String
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  contractId      String?
  contract        Contract?       @relation(fields: [contractId], references: [id])
  description     String?
  serviceCategory ServiceCategory @default(OTHER)
  status          ProjectStatus   @default(QUOTED)
  startDate       DateTime?
  endDate         DateTime?
  budget          Decimal?        @db.Decimal(14, 2)
  managerId       String?
  manager         Employee?       @relation("ProjectManager", fields: [managerId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  documents     Document[]
  invoices      Invoice[]
  expenses      Expense[]
  assignments   ProjectAssignment[]
  statusHistory ProjectStatusHistory[]
  requisitions  PurchaseRequisition[]
  workOrders    WorkOrder[]
}

model ProjectAssignment {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  roleOnProject String?
  assignedAt    DateTime @default(now())

  @@unique([projectId, employeeId])
}

model ProjectStatusHistory {
  id          String         @id @default(uuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus  ProjectStatus?
  toStatus    ProjectStatus
  changedById String
  changedBy   User           @relation(fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime       @default(now())
}

model Document {
  id           String           @id @default(uuid())
  title        String
  category     DocumentCategory @default(GENERAL)
  data         Bytes
  fileName     String
  mimeType     String
  sizeBytes    Int
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id])
  customerId   String?
  customer     Customer?        @relation(fields: [customerId], references: [id])
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())

  certifications Certification[]
}

model WorkOrder {
  id              String          @id @default(uuid())
  workOrderNumber String          @unique
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id])
  title           String
  jobCategory     JobCategory
  description     String?
  status          WorkOrderStatus @default(SCHEDULED)
  scheduledDate   DateTime
  createdById     String
  createdBy       User            @relation("WorkOrderCreator", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  technicians          WorkOrderTechnician[]
  interventionReports  InterventionReport[]
  dailyWorkReportLinks DailyWorkReportWorkOrder[]
}

model WorkOrderTechnician {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])

  @@unique([workOrderId, employeeId])
}

model DailyWorkReport {
  id            String       @id @default(uuid())
  date          DateTime
  summary       String
  hours         Decimal?     @db.Decimal(5, 2)
  status        ReportStatus @default(SUBMITTED)
  submittedById String
  submittedBy   User         @relation("DailyReportSubmitter", fields: [submittedById], references: [id])
  reviewedById  String?
  reviewedBy    User?        @relation("DailyReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime     @default(now())

  technicians DailyWorkReportTechnician[]
  workOrders  DailyWorkReportWorkOrder[]
}

model DailyWorkReportTechnician {
  id                String          @id @default(uuid())
  dailyWorkReportId String
  dailyWorkReport   DailyWorkReport @relation(fields: [dailyWorkReportId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id])

  @@unique([dailyWorkReportId, employeeId])
}

model DailyWorkReportWorkOrder {
  id                String          @id @default(uuid())
  dailyWorkReportId String
  dailyWorkReport   DailyWorkReport @relation(fields: [dailyWorkReportId], references: [id], onDelete: Cascade)
  workOrderId       String
  workOrder         WorkOrder       @relation(fields: [workOrderId], references: [id])

  @@unique([dailyWorkReportId, workOrderId])
}

model InterventionReport {
  id                   String            @id @default(uuid())
  sequenceNumber       Int               @unique @default(autoincrement())
  customerId           String
  customer             Customer          @relation(fields: [customerId], references: [id])
  workOrderId          String?
  workOrder            WorkOrder?        @relation(fields: [workOrderId], references: [id])
  date                 DateTime          @default(now())
  contactPerson        String?
  contactPhone         String?
  contactEmail         String?
  jobCategory          JobCategory
  workType             ServiceCategory
  workTypeOther        String?
  equipment            String?
  make                 String?
  model                String?
  serialNo             String?
  dateInstalled        DateTime?
  natureOfIntervention String
  actionTaken          String
  workCompleted        Boolean           @default(true)
  incompleteDetails    String?
  timeIn               String?
  timeOut              String?
  warrantyStatus       WarrantyStatus?
  technicianReport     String?
  comments             String?
  additionalInfo       String?
  reminderInterval     ReminderInterval?
  nextReminderAt       DateTime?
  signatureData        Bytes?
  signedByName         String?
  signedAt             DateTime?
  attachmentData       Bytes?
  attachmentFileName   String?
  attachmentMimeType   String?
  status               ReportStatus      @default(SUBMITTED)
  createdById          String
  createdBy            User              @relation("InterventionReportCreator", fields: [createdById], references: [id])
  reviewedById         String?
  reviewedBy           User?             @relation("InterventionReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  reviewNote           String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  technicians InterventionReportTechnician[]
  photos      InterventionReportPhoto[]
}

model InterventionReportTechnician {
  id                   String             @id @default(uuid())
  interventionReportId String
  interventionReport   InterventionReport @relation(fields: [interventionReportId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee           @relation(fields: [employeeId], references: [id])

  @@unique([interventionReportId, employeeId])
}

model InterventionReportPhoto {
  id                   String             @id @default(uuid())
  interventionReportId String
  interventionReport   InterventionReport @relation(fields: [interventionReportId], references: [id], onDelete: Cascade)
  kind                 PhotoKind
  data                 Bytes
  fileName             String
  mimeType             String
  createdAt            DateTime           @default(now())
}

model Asset {
  id             String      @id @default(uuid())
  sequenceNumber Int         @unique @default(autoincrement())
  name           String
  category       String?
  serialNumber   String?     @unique
  location       String?
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  status         AssetStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  contracts MaintenanceContract[]
  requests  MaintenanceRequest[]
}

model MaintenanceContract {
  id             String                    @id @default(uuid())
  sequenceNumber Int                       @unique @default(autoincrement())
  assetId        String
  asset          Asset                     @relation(fields: [assetId], references: [id])
  frequency      MaintenanceFrequency
  startDate      DateTime
  expiryDate     DateTime
  status         MaintenanceContractStatus @default(ACTIVE)
  notes          String?
  createdById    String
  createdBy      User                      @relation("MaintenanceContractCreator", fields: [createdById], references: [id])
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  requests  MaintenanceRequest[]
  schedules MaintenanceSchedule[]
}

model MaintenanceRequest {
  id             String                     @id @default(uuid())
  sequenceNumber Int                        @unique @default(autoincrement())
  assetId        String
  asset          Asset                      @relation(fields: [assetId], references: [id])
  contractId     String?
  contract       MaintenanceContract?       @relation(fields: [contractId], references: [id])
  description    String
  priority       MaintenanceRequestPriority @default(MEDIUM)
  status         MaintenanceRequestStatus   @default(SUBMITTED)
  requestedById  String
  requestedBy    User                       @relation("MaintenanceRequestRequester", fields: [requestedById], references: [id])
  createdAt      DateTime                   @default(now())

  schedule MaintenanceSchedule?
}

model MaintenanceSchedule {
  id            String                    @id @default(uuid())
  contractId    String?
  contract      MaintenanceContract?      @relation(fields: [contractId], references: [id])
  requestId     String?                   @unique
  request       MaintenanceRequest?       @relation(fields: [requestId], references: [id])
  scheduledDate DateTime
  status        MaintenanceScheduleStatus @default(SCHEDULED)
  createdById   String
  createdBy     User                      @relation("MaintenanceScheduleCreator", fields: [createdById], references: [id])
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  technicians MaintenanceScheduleTechnician[]
  report      MaintenanceReport?
}

model MaintenanceScheduleTechnician {
  id         String              @id @default(uuid())
  scheduleId String
  schedule   MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee            @relation(fields: [employeeId], references: [id])

  @@unique([scheduleId, employeeId])
}

model MaintenanceReport {
  id              String              @id @default(uuid())
  scheduleId      String              @unique
  schedule        MaintenanceSchedule @relation(fields: [scheduleId], references: [id])
  remarks         String
  workCompleted   Boolean             @default(true)
  recommendations String?
  status          ReportStatus        @default(SUBMITTED)
  submittedById   String
  submittedBy     User                @relation("MaintenanceReportSubmitter", fields: [submittedById], references: [id])
  reviewedById    String?
  reviewedBy      User?               @relation("MaintenanceReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime            @default(now())
}

model PayrollRun {
  id          String   @id @default(uuid())
  year        Int
  month       Int
  createdById String
  createdBy   User     @relation("PayrollRunCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  lines PayrollLine[]

  @@unique([year, month])
}

model PayrollLine {
  id              String     @id @default(uuid())
  payrollRunId    String
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id])
  basicSalary     Decimal    @db.Decimal(12, 2)
  hoursWorked     Decimal    @db.Decimal(6, 2)
  overtimeHours   Decimal    @db.Decimal(6, 2)
  unpaidLeaveDays Decimal    @db.Decimal(5, 2)
  deduction       Decimal    @db.Decimal(12, 2)
  netPay          Decimal    @db.Decimal(12, 2)

  @@unique([payrollRunId, employeeId])
}
